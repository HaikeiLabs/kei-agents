  "cases": [
    {
      "id": "file-bug-basic",
      "prompt": "The login page crashes with a 500 error when I click 'Sign in with Google'. Can you file a bug?",
      "context": {
        "role": "member",
        "groups": [
          "default"
        ],
        "allowed_tools": [
          "file_bug",
          "search_wiki",
          "web_search"
        ]
      },
      "expect": {
        "tool": "file_bug",
        "args": {
          "team_key": "KEI"
        },
        "required_arg_keys": [
          "title",
          "description",
          "severity"
        ],
        "forbidden_arg_keys": [
          "tenant_id",
          "org_id",
          "workspace",
          "workspace_id",
          "repository",
          "owner"
        ]
      }
    },
    {
      "id": "file-bug-named-team-critical",
      "prompt": "File a bug for the OPS team: the nightly database backup job has been failing silently since Monday, so we may have lost data.",
      "context": {
        "role": "member",
        "groups": [
          "default"
        ],
        "allowed_tools": [
          "file_bug",
          "search_wiki",
          "web_search"
        ]
      },
      "expect": {
